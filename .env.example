# 千问大模型 API 密钥（阿里云 DashScope）
# 获取地址：https://dashscope.aliyuncs.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 千问模型名称（可选，默认 qwen-turbo）
# 可选值：qwen-turbo, qwen-plus, qwen-max
QIANWEN_MODEL=qwen-turbo

# 知识库路径（可选，默认 ./data/knowledge_base）
KNOWLEDGE_BASE_PATH=./data/knowledge_base

# 向量存储路径（可选，默认 ./data/vector_store）
VECTOR_STORE_PATH=./data/vector_store

# Coze AI 配置（旧版，保留兼容）
COZE_API_BASE=https://api.coze.cn
COZE_TOKEN=your_coze_token_here
COZE_BOT_ID=your_coze_bot_id_here
